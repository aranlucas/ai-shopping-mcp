{
  "compilerOptions": {
    "target": "ES2024",
    "lib": ["ES2024"],
    "module": "Preserve",
    "strict": true,
    "esModuleInterop": true,
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "types": [
      "./.cloudflare/types/index.d.ts",
      "@cloudflare/vitest-plugin/types"
    ]
  },
  "exclude": ["views", "tools/oxlint/anti-slop"]
}
