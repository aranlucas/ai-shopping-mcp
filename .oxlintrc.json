{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "extends": [
    "./node_modules/@aranlucas/oxforge/configs/recommended.json",
    "./node_modules/@aranlucas/oxforge/configs/react.json",
    "./node_modules/@aranlucas/oxforge/configs/vitest.json",
    "./node_modules/@aranlucas/oxforge/configs/tailwind.json",
    "./node_modules/@aranlucas/oxforge/configs/type-aware.json"
  ],
  "jsPlugins": ["oxlint-tailwindcss", "@shadcn/lint"],
  "plugins": [
    "eslint",
    "typescript",
    "oxc",
    "unicorn",
    "import",
    "react",
    "react-perf",
    "jsx-a11y",
    "promise",
    "node",
    "vitest"
  ],
  "env": {
    "builtin": true
  },
  "globals": {},
  "settings": {
    "shadcn": {
      "componentImports": [
        "^(?:\\.\\./)*(?:\\./)?(?:shared/)?ui/",
        "^(?:\\.\\./)*(?:\\./)?(?:shared/)?components(?:\\.js)?$"
      ]
    },
    "tailwindcss": {
      "entryPoint": "views/styles.css",
      "timeout": 120000
    },
    "jsx-a11y": {
      "polymorphicPropName": null,
      "components": {},
      "attributes": {}
    },
    "next": {
      "rootDir": []
    },
    "react": {
      "formComponents": [],
      "linkComponents": [],
      "version": "19.0",
      "componentWrapperFunctions": []
    },
    "jsdoc": {
      "ignorePrivate": false,
      "ignoreInternal": false,
      "ignoreReplacesDocs": true,
      "overrideReplacesDocs": true,
      "augmentsExtendsReplacesDocs": false,
      "implementsReplacesDocs": false,
      "exemptDestructuredRootsFromChecks": false,
      "tagNamePreference": {}
    },
    "vitest": {
      "typecheck": false
    }
  },
  "rules": {
    "unicorn/filename-case": [
      "error",
      {
        "case": "kebabCase"
      }
    ],
    "eslint/eqeqeq": [
      "error",
      "always",
      {
        "null": "ignore"
      }
    ],
    "eslint/no-shadow": "error",
    "eslint/preserve-caught-error": "error",
    "eslint/no-await-in-loop": "error",
    "typescript/consistent-type-imports": "error",
    "typescript/no-explicit-any": "error",
    "import/no-duplicates": "error",
    "import/no-named-as-default": "error",
    "eslint/no-underscore-dangle": [
      "error",
      {
        "allow": ["_meta", "_unsafeUnwrap", "_unsafeUnwrapErr"]
      }
    ],
    "unicorn/no-array-sort": "error",
    "react-perf/jsx-no-new-function-as-prop": "error",
    "react-perf/jsx-no-jsx-as-prop": "error",
    "react-perf/jsx-no-new-object-as-prop": "error",
    "jsx-a11y/alt-text": "error",
    "jsx-a11y/aria-props": "error",
    "jsx-a11y/aria-role": "error",
    "jsx-a11y/aria-unsupported-elements": "error",
    "jsx-a11y/no-redundant-roles": "error",
    "promise/param-names": "error",
    "promise/no-nesting": "error",
    "oxc/no-accumulating-spread": "error",
    "vitest/valid-expect": [
      "error",
      {
        "maxArgs": 2
      }
    ],
    "eslint/no-console": [
      "error",
      {
        "allow": ["warn", "error"]
      }
    ],
    "unicorn/no-useless-undefined": [
      "error",
      {
        "checkArguments": false
      }
    ]
  },
  "overrides": [
    {
      "files": ["test/strict-fake.ts"],
      "rules": {
        "anti-slop/no-runtime-typeof": [
          "error",
          {
            "allowInTypeGuards": true
          }
        ],
        "anti-slop/no-unknown-returns": "off"
      }
    },
    {
      "files": ["views/**/*.tsx"],
      "rules": {
        "shadcn/no-restyle": [
          "error",
          {
            "allow": ["layout"],
            "contracts": [
              {
                "pattern": "^(Card|CardHeader|CardContent|CardFooter|Empty)$",
                "allow": ["layout", "spacing"]
              },
              {
                "pattern": "^CarouselItem$",
                "allow": ["layout", "ps"]
              },
              {
                "pattern": "^Skeleton$",
                "allow": ["layout", "rounded"]
              }
            ]
          }
        ],
        "shadcn/require-static-classes": "error",
        "shadcn/no-inline-styles": "error"
      }
    },
    {
      "files": ["test/**/*.test.ts", "test/**/*.ts"],
      "rules": {
        "typescript/no-explicit-any": "error"
      }
    },
    {
      "files": [
        "src/errors.ts",
        "src/utils/result.ts",
        "src/utils/user-storage.ts",
        "scripts/eval-agent-codex.mjs",
        "test/auth-stub.mjs"
      ],
      "rules": {
        "anti-slop/no-runtime-typeof": "off"
      }
    },
    {
      "files": [
        "src/utils/result.ts",
        "src/utils/toon.ts",
        "test/v2-tool-handler.ts",
        "test/evals/harness.ts"
      ],
      "rules": {
        "anti-slop/no-unknown-parameters": "off"
      }
    },
    {
      "files": ["src/utils/json.ts"],
      "rules": {
        "anti-slop/no-unknown-returns": "off"
      }
    },
    {
      "files": ["src/errors.ts", "src/services/kroger/weekly-deals.d.ts"],
      "rules": {
        "anti-slop/no-unsafe-dictionary-type": "off"
      }
    },
    {
      "files": ["views/shopping-app.tsx"],
      "rules": {
        "unicorn/prefer-add-event-listener": "off"
      }
    },
    {
      "files": [
        "scripts/**/*.mjs",
        "scripts/**/*.ts",
        "test/scripts/**/*.mjs",
        "test/scripts/**/*.ts",
        "test/evals/token-budget.eval.test.ts"
      ],
      "rules": {
        "eslint/no-console": [
          "error",
          {
            "allow": ["log", "warn", "error", "info"]
          }
        ]
      }
    },
    {
      "files": [
        "test/**",
        "src/cart-operations.ts",
        "src/prompts.ts",
        "src/server.ts",
        "src/services/kroger/client.ts",
        "src/services/kroger/product-service.ts",
        "src/services/weekly-deals/runtime.ts",
        "src/tools/cart.ts",
        "src/utils/d1-shopping-storage.ts",
        "src/utils/user-storage.ts",
        "views/preview-app.tsx",
        "views/shopping-app.tsx"
      ],
      "rules": {
        "eslint/require-await": "off",
        "typescript/require-await": "off"
      }
    },
    {
      "files": ["test/utils/result.test.ts", "test/utils/request-timeout.test.ts"],
      "rules": {
        "eslint/prefer-promise-reject-errors": "off",
        "typescript/prefer-promise-reject-errors": "off"
      }
    },
    {
      "files": [
        "views/shared/types.ts",
        "test/evals/agent/harness.ts",
        "views/app/tool-calls.ts",
        "views/app/views/weekly-deals.tsx",
        "test/evals/agent/codex-harness.ts"
      ],
      "rules": {
        "unicorn/prefer-type-error": "off"
      }
    },
    {
      "files": ["test/evals/harness.ts"],
      "rules": {
        "unicorn/prefer-code-point": "off"
      }
    },
    {
      "files": ["src/tools/weekly-deals.ts", "test/tools/cart.test.ts"],
      "rules": {
        "unicorn/no-object-as-default-parameter": "off"
      }
    },
    {
      "files": ["scripts/eval-agent-selector-live.mjs"],
      "rules": {
        "eslint/max-depth": ["error", 5]
      }
    },
    {
      "files": ["src/utils/user-storage.ts"],
      "rules": {
        "eslint/max-classes-per-file": ["error", 2]
      }
    }
  ],
  "ignorePatterns": [
    "src/services/kroger/cart.d.ts",
    "src/services/kroger/location.d.ts",
    "src/services/kroger/product.d.ts",
    "src/services/kroger/identity.d.ts",
    "views/shared/ui/**",
    "dist/**",
    "coverage/**",
    ".agent/**",
    ".agents/**",
    ".claude/**",
    ".codex/**",
    ".continue/**",
    ".cursor/**",
    ".gemini/**",
    ".opencode/**",
    ".pi/**",
    ".roo/**",
    ".windsurf/**",
    "**/node_modules/**",
    "**/dist/**",
    "**/build/**",
    "**/coverage/**",
    "**/.next/**",
    "**/.expo/**",
    "**/.vercel/**",
    "**/.agent/**",
    "**/.agents/**",
    "**/.claude/**",
    "**/.codex/**",
    "**/.continue/**",
    "**/.cursor/**",
    "**/.gemini/**",
    "**/.opencode/**",
    "**/.pi/**",
    "**/.roo/**",
    "**/.windsurf/**"
  ],
  "options": {
    "typeAware": true
  }
}
