{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "extends": ["./.oxlintrc.tailwind.json"],
  "jsPlugins": ["oxlint-tailwindcss"],
  "plugins": [
    "eslint",
    "typescript",
    "oxc",
    "unicorn",
    "import",
    "react",
    "react-perf",
    "jsx-a11y",
    "promise",
    "node",
    "vitest"
  ],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "error",
    "pedantic": "off",
    "style": "off",
    "restriction": "off",
    "nursery": "off"
  },
  "rules": {
    "unicorn/filename-case": ["error", { "case": "kebabCase" }],

    // Strict equality, but allow `== null` for null/undefined checks.
    "eslint/eqeqeq": ["error", "always", { "null": "ignore" }],
    "eslint/no-shadow": "error",
    "eslint/preserve-caught-error": "error",
    "eslint/no-await-in-loop": "error",

    // TypeScript strictness (valuable, low noise in this repo).
    "typescript/consistent-type-imports": "error",
    "typescript/no-floating-promises": "error",
    "typescript/no-misused-promises": "error",
    "typescript/no-non-null-assertion": "error",
    "typescript/no-explicit-any": "error",

    // Imports.
    "import/no-duplicates": "error",
    "import/no-named-as-default": "error",

    // React 19 with jsx: react-jsx — no React import needed.
    // (Rule is obsolete with the new JSX transform; disabling is the fix.)
    "react/react-in-jsx-scope": "off",
    "unicorn/prefer-add-event-listener": "error",
    // Allow SDK / library-mandated underscore names; everything else still errors.
    "eslint/no-underscore-dangle": [
      "error",
      { "allow": ["_meta", "_unsafeUnwrap", "_unsafeUnwrapErr"] }
    ],
    "unicorn/no-array-sort": "error",

    // Perf: inline closures / JSX props re-create handlers per render.
    "react-perf/jsx-no-new-function-as-prop": "error",
    "react-perf/jsx-no-jsx-as-prop": "error",
    "react-perf/jsx-no-new-object-as-prop": "error",

    // Accessibility and promises are high-signal for this UI + Worker codebase.
    "jsx-a11y/alt-text": "error",
    "jsx-a11y/aria-props": "error",
    "jsx-a11y/aria-role": "error",
    "jsx-a11y/aria-unsupported-elements": "error",
    "jsx-a11y/no-redundant-roles": "error",
    "promise/param-names": "error",
    "promise/no-nesting": "error"
  },
  "settings": {
    "tailwindcss": {
      "entryPoint": "views/styles.css",
      "timeout": 120000
    },
    "jsx-a11y": {
      "polymorphicPropName": null,
      "components": {},
      "attributes": {}
    },
    "next": {
      "rootDir": []
    },
    "react": {
      "formComponents": [],
      "linkComponents": [],
      "version": "19.0",
      "componentWrapperFunctions": []
    },
    "jsdoc": {
      "ignorePrivate": false,
      "ignoreInternal": false,
      "ignoreReplacesDocs": true,
      "overrideReplacesDocs": true,
      "augmentsExtendsReplacesDocs": false,
      "implementsReplacesDocs": false,
      "exemptDestructuredRootsFromChecks": false,
      "tagNamePreference": {}
    },
    "vitest": {
      "typecheck": false
    }
  },
  "env": {
    "builtin": true
  },
  "globals": {},
  "ignorePatterns": ["worker-configuration.d.ts", "packages/**", "dist/**", "coverage/**"],
  "overrides": [
    {
      "files": ["scripts/**/*.mjs", "scripts/**/*.js"],
      "rules": {
        "eslint/no-await-in-loop": "warn"
      }
    },
    {
      "files": ["tests/**/*.test.ts", "tests/**/*.ts"],
      "rules": {
        "typescript/no-explicit-any": "error"
      }
    }
  ]
}
