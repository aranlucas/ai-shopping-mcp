{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "extends": [
    "./node_modules/@aranlucas/oxforge/configs/recommended.json",
    "./node_modules/@aranlucas/oxforge/configs/react.json",
    "./node_modules/@aranlucas/oxforge/configs/vitest.json",
    "./node_modules/@aranlucas/oxforge/configs/tailwind.json",
    "./node_modules/@aranlucas/oxforge/configs/type-aware.json"
  ],
  "jsPlugins": ["oxlint-tailwindcss", "@shadcn/lint"],
  "plugins": [
    "eslint",
    "typescript",
    "oxc",
    "unicorn",
    "import",
    "react",
    "react-perf",
    "jsx-a11y",
    "promise",
    "node",
    "vitest"
  ],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "error",
    "pedantic": "off",
    "style": "off",
    "restriction": "off",
    "nursery": "off"
  },
  "env": {
    "builtin": true
  },
  "globals": {},
  "settings": {
    "shadcn": {
      "componentImports": [
        "^(?:\\.\\./)*(?:\\./)?(?:shared/)?ui/",
        "^(?:\\.\\./)*(?:\\./)?(?:shared/)?components(?:\\.js)?$"
      ]
    },
    "tailwindcss": {
      "entryPoint": "views/styles.css",
      "timeout": 120000
    },
    "jsx-a11y": {
      "polymorphicPropName": null,
      "components": {},
      "attributes": {}
    },
    "next": {
      "rootDir": []
    },
    "react": {
      "formComponents": [],
      "linkComponents": [],
      "version": "19.0",
      "componentWrapperFunctions": []
    },
    "jsdoc": {
      "ignorePrivate": false,
      "ignoreInternal": false,
      "ignoreReplacesDocs": true,
      "overrideReplacesDocs": true,
      "augmentsExtendsReplacesDocs": false,
      "implementsReplacesDocs": false,
      "exemptDestructuredRootsFromChecks": false,
      "tagNamePreference": {}
    },
    "vitest": {
      "typecheck": false
    }
  },
  "rules": {
    "unicorn/filename-case": [
      "error",
      {
        "case": "kebabCase"
      }
    ],
    "eslint/eqeqeq": [
      "error",
      "always",
      {
        "null": "ignore"
      }
    ],
    "eslint/no-shadow": "error",
    "eslint/preserve-caught-error": "error",
    "eslint/no-await-in-loop": "error",
    "typescript/consistent-type-imports": "error",
    "typescript/no-non-null-assertion": "off",
    "typescript/no-explicit-any": "error",
    "import/no-duplicates": "error",
    "import/no-named-as-default": "error",
    "eslint/no-restricted-imports": "off",
    "react/react-in-jsx-scope": "off",
    "unicorn/prefer-add-event-listener": "off",
    "eslint/no-underscore-dangle": [
      "error",
      {
        "allow": ["_meta", "_unsafeUnwrap", "_unsafeUnwrapErr"]
      }
    ],
    "unicorn/no-array-sort": "error",
    "react-perf/jsx-no-new-function-as-prop": "error",
    "react-perf/jsx-no-jsx-as-prop": "error",
    "react-perf/jsx-no-new-object-as-prop": "error",
    "jsx-a11y/alt-text": "error",
    "jsx-a11y/aria-props": "error",
    "jsx-a11y/aria-role": "error",
    "jsx-a11y/aria-unsupported-elements": "error",
    "jsx-a11y/no-redundant-roles": "error",
    "promise/param-names": "error",
    "promise/no-nesting": "error",
    "oxc/no-accumulating-spread": "error",
    "eslint/curly": "off",
    "eslint/no-console": "off",
    "eslint/no-magic-numbers": "off",
    "eslint/id-length": "off",
    "eslint/max-lines": "off",
    "eslint/max-lines-per-function": "off",
    "eslint/max-statements": "off",
    "eslint/func-style": "off",
    "eslint/no-inline-comments": "off",
    "eslint/no-negated-condition": "off",
    "eslint/new-cap": "off",
    "unicorn/no-useless-undefined": "off",
    "unicorn/prefer-code-point": "off",
    "unicorn/no-this-assignment": "off",
    "unicorn/consistent-function-scoping": "off",
    "react/button-has-type": "off",
    "eslint/radix": "off",
    "anti-slop/no-array-filter-map": "off",
    "anti-slop/no-chained-type-assertions": "off",
    "anti-slop/no-conditional-empty-object-spread": "off",
    "anti-slop/no-known-value-widening": "off",
    "anti-slop/no-module-mocking": "off",
    "anti-slop/no-object-parameters": "off",
    "anti-slop/no-reduce-accumulator-copy": "off",
    "anti-slop/no-reflect-apply": "off",
    "anti-slop/no-reflect-get": "off",
    "anti-slop/no-runtime-typeof": "off",
    "anti-slop/no-shape-in-symbol-names": "off",
    "anti-slop/no-unknown-parameters": "off",
    "anti-slop/no-unknown-returns": "off",
    "anti-slop/no-unknown-type-aliases": "off",
    "anti-slop/no-unsafe-dictionary-type": "off",
    "anti-slop/no-widen-then-assert": "off",
    "anti-slop/require-readable-spacing": "off",
    "anti-slop/require-safety-comment-for-type-assertion": "off"
  },
  "overrides": [
    {
      "files": ["tests/strict-fake.ts"],
      "rules": {
        "anti-slop/no-runtime-typeof": [
          "error",
          {
            "allowInTypeGuards": true
          }
        ]
      }
    },
    {
      "files": ["views/**/*.tsx"],
      "rules": {
        "shadcn/no-restyle": [
          "error",
          {
            "allow": ["layout"],
            "contracts": [
              {
                "pattern": "^(Card|CardHeader|CardContent|CardFooter|Empty)$",
                "allow": ["layout", "spacing"]
              },
              {
                "pattern": "^CarouselItem$",
                "allow": ["layout", "ps"]
              },
              {
                "pattern": "^Skeleton$",
                "allow": ["layout", "rounded"]
              }
            ]
          }
        ],
        "shadcn/require-static-classes": "error",
        "shadcn/no-inline-styles": "error"
      }
    },
    {
      "files": ["scripts/**/*.mjs", "scripts/**/*.js"],
      "rules": {
        "eslint/no-await-in-loop": "warn"
      }
    },
    {
      "files": ["tests/**/*.test.ts", "tests/**/*.ts"],
      "rules": {
        "typescript/no-explicit-any": "error"
      }
    }
  ],
  "ignorePatterns": [
    "src/services/kroger/cart.d.ts",
    "src/services/kroger/location.d.ts",
    "src/services/kroger/product.d.ts",
    "src/services/kroger/identity.d.ts",
    "views/shared/ui/**",
    "dist/**",
    "coverage/**",
    ".agent/**",
    ".agents/**",
    ".claude/**",
    ".codex/**",
    ".continue/**",
    ".cursor/**",
    ".gemini/**",
    ".opencode/**",
    ".pi/**",
    ".roo/**",
    ".windsurf/**",
    "**/node_modules/**",
    "**/dist/**",
    "**/build/**",
    "**/coverage/**",
    "**/.next/**",
    "**/.expo/**",
    "**/.vercel/**",
    "**/.agent/**",
    "**/.agents/**",
    "**/.claude/**",
    "**/.codex/**",
    "**/.continue/**",
    "**/.cursor/**",
    "**/.gemini/**",
    "**/.opencode/**",
    "**/.pi/**",
    "**/.roo/**",
    "**/.windsurf/**"
  ],
  "options": {
    "typeAware": true
  }
}
