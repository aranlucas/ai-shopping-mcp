{
  "name": "ai-shopping-mcp",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm build:worker && pnpm lint && pnpm typecheck",
    "build:views": "vite build --config vite.views.config.ts",
    "dev:views": "portless run --name views.ai-shopping-mcp vite --config vite.views.config.ts",
    "watch": "NODE_ENV=development vite build --config vite.views.config.ts --watch",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit && tsc --noEmit -p views/tsconfig.json",
    "eval:mcp": "vitest run test/evals",
    "deploy": "pnpm build:worker && cf deploy --prebuilt --mode production",
    "deploy:preview": "pnpm build:views && cf previews deploy",
    "dev": "pnpm build:views && NODE_ENV=development concurrently \"pnpm watch\" \"portless run cf dev\"",
    "start": "pnpm build:views && portless run cf dev",
    "cf-typegen": "cf workers types",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix --fix-suggestions",
    "fmt": "oxfmt --config oxfmt.config.ts",
    "fmt:check": "oxfmt --config oxfmt.config.ts --check",
    "generate:apis": "pnpm generate:cart && pnpm generate:location && pnpm generate:product && pnpm generate:identity",
    "generate:cart": "pnpm dlx openapi-typescript@7.13.0 kroger/cart.json -o src/services/kroger/cart.d.ts",
    "generate:location": "pnpm dlx openapi-typescript@7.13.0 kroger/location.json -o src/services/kroger/location.d.ts",
    "generate:product": "pnpm dlx openapi-typescript@7.13.0 kroger/product.json -o src/services/kroger/product.d.ts",
    "generate:identity": "pnpm dlx openapi-typescript@7.13.0 kroger/identity.json -o src/services/kroger/identity.d.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "cf d1 migrations apply 7a03710e-48aa-445c-832d-fb14197e064b --local --persist-to .cloudflare/state",
    "db:migrate:remote": "cf d1 migrations apply 7a03710e-48aa-445c-832d-fb14197e064b",
    "build:worker": "pnpm build:views && cf build",
    "format": "oxfmt --config oxfmt.config.ts --write",
    "format:check": "oxfmt --config oxfmt.config.ts --check",
    "prepare": "husky"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@better-auth/core": "1.7.12",
    "@better-auth/mcp": "1.7.12",
    "@better-auth/oauth-provider": "1.7.12",
    "@modelcontextprotocol/client": "2.4.0",
    "@modelcontextprotocol/ext-apps": "^2.0.3",
    "@modelcontextprotocol/hono": "2.0.2",
    "@modelcontextprotocol/server": "2.4.0",
    "@sentry/cloudflare": "^11.9.0",
    "@tailwindcss/vite": "^4.3.3",
    "@toon-format/toon": "^4.4.0",
    "agents": "^0.30.1",
    "better-auth": "1.7.12",
    "better-call": "2.0.6",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "drizzle-orm": "0.45.4",
    "embla-carousel-react": "^8.6.0",
    "hono": "^4.13.13",
    "jose": "^6.2.13",
    "lucide-react": "^1.61.0",
    "neverthrow": "^8.2.0",
    "openapi-fetch": "^0.17.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "shadcn": "^4.22.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@aranlucas/oxforge": "0.2.4",
    "@babel/core": "^8.0.9",
    "@cloudflare/vite-plugin": "2.0.0-beta.v.2",
    "@cloudflare/vitest-plugin": "^1.4.7",
    "@shadcn/lint": "^0.2.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-istanbul": "~5.0.5",
    "cf": "1.0.0-beta.21",
    "concurrently": "^10.0.6",
    "drizzle-kit": "0.31.11",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "oxlint-tailwindcss": "1.16.0",
    "oxlint-tsgolint": "^7.0.2005",
    "portless": "0.15.11",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "~5.0.5"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs,mts,cts}": [
      "oxlint --fix",
      "oxfmt --config oxfmt.config.ts --no-error-on-unmatched-pattern"
    ],
    "*.{json,jsonc,json5,css,scss,md,mdx,yml,yaml,html,toml,vue,graphql}": [
      "oxfmt --config oxfmt.config.ts --no-error-on-unmatched-pattern"
    ]
  },
  "engines": {
    "node": ">=24.18.1"
  },
  "packageManager": "pnpm@12.15.0"
}
