{
  "name": "ai-shopping-list-mcp",
  "version": "1.0.0",
  "private": true,
  "description": "",
  "keywords": [],
  "license": "ISC",
  "author": "",
  "type": "module",
  "scripts": {
    "build": "pnpm lint && pnpm build:views && pnpm typecheck",
    "typecheck": "pnpm cf-typegen && tsc --noEmit && tsc --noEmit -p views/tsconfig.json",
    "build:views": "INPUT=mcp-app.html vite build",
    "watch": "NODE_ENV=development INPUT=mcp-app.html vite build --watch",
    "serve": "wrangler dev",
    "test": "vitest run",
    "eval:mcp": "vitest run tests/evals",
    "test:reranker:live": "node scripts/test-reranker-live.mjs",
    "deploy": "pnpm build:views && wrangler deploy",
    "dev": "NODE_ENV=development concurrently \"pnpm watch\" \"pnpm serve\"",
    "start": "wrangler dev",
    "cf-typegen": "wrangler types",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "generate:apis": "pnpm generate:cart && pnpm generate:location && pnpm generate:product && pnpm generate:identity && pnpm generate:catalog",
    "generate:cart": "openapi-typescript kroger/cart.json -o src//services/kroger/cart.d.ts",
    "generate:catalog": "openapi-typescript kroger/catalog.json -o src//services/kroger/catalog.d.ts",
    "generate:location": "openapi-typescript kroger/location.json -o src/services/kroger/location.d.ts",
    "generate:product": "openapi-typescript kroger/product.json -o src/services/kroger/product.d.ts",
    "generate:identity": "openapi-typescript kroger/identity.json -o src/services/kroger/identity.d.ts",
    "prepare": "husky"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@cloudflare/workers-oauth-provider": "^0.8.3",
    "@fontsource-variable/geist": "^5.3.0",
    "@mcp-ui/server": "^6.1.0",
    "@modelcontextprotocol/ext-apps": "^1.7.5",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@modelcontextprotocol/server": "2.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "@toon-format/toon": "^4.1.0",
    "agents": "^0.20.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "hono": "^4.12.33",
    "input-otp": "^1.4.2",
    "lucide-react": "^1.28.0",
    "neverthrow": "^8.2.0",
    "next-themes": "^0.4.6",
    "openapi-fetch": "^0.17.0",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.8",
    "react-resizable-panels": "^4.12.2",
    "recharts": "3.10.1",
    "shadcn": "^4.16.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.20.1",
    "@modelcontextprotocol/client": "2.0.0",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-istanbul": "^4.1.10",
    "concurrently": "^10.0.4",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "openapi-typescript": "^7.13.0",
    "oxfmt": "^0.61.0",
    "oxlint": "^1.76.0",
    "supertest": "^7.2.2",
    "ts-node": "^10.9.2",
    "typescript": "^7.0.2",
    "vite": "^8.2.0",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^4.1.10",
    "wrangler": "4.118.0"
  },
  "overrides": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "ws": "8.20.1"
  },
  "lint-staged": {
    "*": "oxfmt --no-error-on-unmatched-pattern && pnpm lint:fix"
  },
  "engines": {
    "node": ">=24.18.1"
  },
  "packageManager": "pnpm@11.18.0"
}
