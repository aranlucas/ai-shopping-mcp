{
  "name": "ai-shopping-list-mcp",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm lint && pnpm build:views && pnpm typecheck",
    "build:views": "vite build",
    "dev:views": "portless run --name views.ai-shopping-mcp vite --host 127.0.0.1",
    "watch": "NODE_ENV=development vite build --watch",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "typecheck": "pnpm cf-typegen && tsc --noEmit && tsc --noEmit -p views/tsconfig.json",
    "eval:mcp": "vitest run tests/evals",
    "eval:agent": "node scripts/eval-agent.mjs",
    "eval:agent:codex": "node scripts/eval-agent-codex.mjs",
    "eval:agent:summary": "node scripts/eval-agent-summary.mjs",
    "test:selector:live": "node scripts/test-selector-live.mjs",
    "deploy": "pnpm build:worker && cf deploy --prebuilt",
    "deploy:preview": "pnpm build:views && cf previews deploy",
    "dev": "portless",
    "start": "cf dev",
    "cf-typegen": "cf workers types",
    "lint": "oxlint && pnpm lint:types",
    "lint:types": "pnpm cf-typegen && oxlint -c .oxlintrc.type-aware.json",
    "lint:fix": "oxlint --fix --fix-suggestions && pnpm lint:types",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "generate:apis": "pnpm generate:cart && pnpm generate:location && pnpm generate:product && pnpm generate:identity",
    "generate:cart": "pnpm dlx openapi-typescript@7.13.0 kroger/cart.json -o src/services/kroger/cart.d.ts",
    "generate:location": "pnpm dlx openapi-typescript@7.13.0 kroger/location.json -o src/services/kroger/location.d.ts",
    "generate:product": "pnpm dlx openapi-typescript@7.13.0 kroger/product.json -o src/services/kroger/product.d.ts",
    "generate:identity": "pnpm dlx openapi-typescript@7.13.0 kroger/identity.json -o src/services/kroger/identity.d.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "cf d1 migrations apply 7a03710e-48aa-445c-832d-fb14197e064b --local",
    "db:migrate:remote": "cf d1 migrations apply 7a03710e-48aa-445c-832d-fb14197e064b",
    "eval:selector:live": "node scripts/eval-selector-live.mjs",
    "eval:agent-selector:live": "node scripts/eval-agent-selector-live.mjs",
    "build:worker": "pnpm build:views && cf build",
    "eval:agent:report": "vitest-evals serve eval-results",
    "dev:direct": "NODE_ENV=development concurrently \"pnpm watch\" \"pnpm start\"",
    "dev:views:direct": "vite --host 127.0.0.1"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@cloudflare/workers-oauth-provider": "^1.2.3",
    "@modelcontextprotocol/client": "2.3.1",
    "@modelcontextprotocol/ext-apps": "^2.0.3",
    "@modelcontextprotocol/server": "2.3.1",
    "@sentry/cloudflare": "^11.6.0",
    "@tailwindcss/vite": "^4.3.3",
    "@toon-format/toon": "^4.1.1",
    "agents": "^0.27.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "drizzle-orm": "0.45.4",
    "embla-carousel-react": "^8.6.0",
    "hono": "^4.13.13",
    "lucide-react": "^1.53.0",
    "neverthrow": "^8.2.0",
    "openapi-fetch": "^0.17.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "shadcn": "^4.21.4",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@babel/core": "^8.0.7",
    "@cloudflare/vitest-plugin": "^1.4.0",
    "@openrouter/ai-sdk-provider": "^3.1.0",
    "@oxlint/plugins": "1.87.0",
    "@shadcn/lint": "^0.2.0",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest-evals/harness-ai-sdk": "^0.17.0",
    "@vitest/coverage-istanbul": "~5.0.3",
    "ai": "^7.0.134",
    "cf": "1.0.0-beta.13",
    "concurrently": "^10.0.6",
    "drizzle-kit": "0.31.11",
    "oxfmt": "^0.72.0",
    "oxlint": "1.87.0",
    "oxlint-tailwindcss": "1.14.0",
    "oxlint-tsgolint": "^7.0.2003",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "~5.0.3",
    "vitest-evals": "^0.17.0",
    "wrangler": "^4.149.0"
  },
  "engines": {
    "node": ">=24.18.1"
  },
  "packageManager": "pnpm@12.10.1",
  "portless": {
    "name": "ai-shopping-mcp",
    "script": "dev:direct"
  }
}
