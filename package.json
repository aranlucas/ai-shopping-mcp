{
  "name": "ai-shopping-list-mcp",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm lint && pnpm build:views && pnpm typecheck",
    "build:views": "vite build",
    "dev:views": "vite --host 127.0.0.1",
    "watch": "NODE_ENV=development vite build --watch",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit && tsc --noEmit -p views/tsconfig.json",
    "eval:mcp": "vitest run tests/evals",
    "test:selector:live": "node scripts/test-selector-live.mjs",
    "deploy": "pnpm build:views && wrangler deploy",
    "dev": "NODE_ENV=development concurrently \"pnpm watch\" \"pnpm start\"",
    "start": "wrangler dev",
    "cf-typegen": "wrangler types",
    "lint": "oxlint && pnpm lint:types",
    "lint:types": "oxlint -c .oxlintrc.type-aware.json",
    "lint:fix": "oxlint --fix --fix-suggestions && pnpm lint:types",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "generate:apis": "pnpm generate:cart && pnpm generate:location && pnpm generate:product && pnpm generate:identity",
    "generate:cart": "pnpm dlx openapi-typescript@7.13.0 kroger/cart.json -o src/services/kroger/cart.d.ts",
    "generate:location": "pnpm dlx openapi-typescript@7.13.0 kroger/location.json -o src/services/kroger/location.d.ts",
    "generate:product": "pnpm dlx openapi-typescript@7.13.0 kroger/product.json -o src/services/kroger/product.d.ts",
    "generate:identity": "pnpm dlx openapi-typescript@7.13.0 kroger/identity.json -o src/services/kroger/identity.d.ts",
    "generate:gateway": "pnpm dlx openapi-typescript@7.13.0 openapi/grocery-gateway.yaml -o src/services/gateway/schema.d.ts",
    "api:check": "pnpm generate:gateway && git diff --exit-code -- src/services/gateway/schema.d.ts",
    "eval:selector:live": "node scripts/eval-selector-live.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@cloudflare/workers-oauth-provider": "^0.10.3",
    "@modelcontextprotocol/client": "2.0.0",
    "@modelcontextprotocol/ext-apps": "^2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "@sentry/cloudflare": "^10.75.0",
    "@tailwindcss/vite": "^4.3.3",
    "@toon-format/toon": "^4.1.1",
    "agents": "^0.23.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.3.0",
    "embla-carousel-react": "^8.6.0",
    "graphql": "^17.0.2",
    "graphql-request": "^7.4.0",
    "hono": "^4.13.8",
    "lucide-react": "^1.46.0",
    "neverthrow": "^8.2.0",
    "openapi-fetch": "^0.17.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "shadcn": "^4.20.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@babel/core": "^8.0.5",
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@types/node": "^26.5.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-istanbul": "^4.1.11",
    "concurrently": "^10.0.5",
    "oxfmt": "^0.68.0",
    "oxlint": "^1.83.0",
    "oxlint-tailwindcss": "1.12.0",
    "oxlint-tsgolint": "^7.0.2001",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^4.1.11",
    "wrangler": "^4.135.0"
  },
  "engines": {
    "node": ">=24.18.1"
  },
  "packageManager": "pnpm@12.4.2"
}
